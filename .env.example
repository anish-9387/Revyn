# ---------- App ----------
REVYN_ENV=development
REVYN_LOG_LEVEL=INFO
REVYN_API_PREFIX=/api/v1

# ---------- Database ----------
# SQLite needs no setup. Docker Compose sets Postgres automatically.
REVYN_DATABASE_URL=sqlite+aiosqlite:///./revyn.db
# REVYN_DATABASE_URL=postgresql+asyncpg://revyn:revyn@localhost:5432/revyn

# ---------- Cache / Idempotency ----------
# Optional. Without it Revyn uses in-process locks/cache. Set in production for multi-replica safety.
# REVYN_REDIS_URL=redis://localhost:6379/0

# ---------- CORS ----------
# Comma-separated. Must include the origin you serve the frontend from.
# REVYN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Security - definitely set before sharing or deploying ----------
# When REVYN_API_KEY is set, every mutating route requires header X-API-Key.
# Frontend must send the same value via NEXT_PUBLIC_API_KEY (baked at build time).
# If left empty, mutating routes are open - acceptable only for local demo.
# REVYN_API_KEY=change-me-32chars
# NEXT_PUBLIC_API_KEY=change-me-32chars  # also set in frontend/.env

# ---------- LLM - optional: Hinglish generation & promise extraction ----------
# Without a key the system runs fully deterministic (no network, no cost).
# When set, the LLM never controls a financial API - it only generates language,
# which is validated by deterministic code before send.
# ANTHROPIC_API_KEY=sk-ant-...
REVYN_LLM_ENABLED=true
REVYN_LLM_MODEL=claude-sonnet-4-20250514
REVYN_LLM_EFFORT=low

# ---------- Payments - simulator is the default (offline, no money moves) ----------
REVYN_GATEWAY=simulator
# To hit real Razorpay test mode on one path, uncomment and use test keys:
# REVYN_GATEWAY=razorpay
# REVYN_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# REVYN_RAZORPAY_KEY_SECRET=xxxxxxxx
# REVYN_RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# ---------- Orchestrator ----------
REVYN_SCHEDULER_ENABLED=true
REVYN_SCHEDULER_INTERVAL_SECONDS=10
REVYN_CLOCK_SPEEDUP=120
# REVYN_MAX_ACTIONS_PER_TICK=25

# ---------- Frontend (baked into the Next.js bundle at build) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1