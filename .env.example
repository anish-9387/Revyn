# ---------- Core ----------
REVYN_ENV=development
REVYN_LOG_LEVEL=INFO
REVYN_API_PREFIX=/api/v1

# ---------- Database ----------
# Local default (zero setup). Docker Compose overrides this with Postgres.
REVYN_DATABASE_URL=sqlite+aiosqlite:///./revyn.db
# REVYN_DATABASE_URL=postgresql+asyncpg://revyn:revyn@localhost:5432/revyn

# ---------- Security ----------
# Optional. When set, mutating routes require X-API-Key header.
# REVYN_API_KEY=change-me
# NEXT_PUBLIC_API_KEY=change-me  (frontend env, must match)

# ---------- Cache / locks ----------
# Optional. Falls back to an in-process backend when unset.
# REVYN_REDIS_URL=redis://localhost:6379/0

# ---------- LLM (Anthropic) ----------
# Optional. Without a key Revyn runs on its deterministic reasoning provider.
# ANTHROPIC_API_KEY=sk-ant-...
REVYN_LLM_MODEL=claude-opus-5
REVYN_LLM_ENABLED=true
REVYN_LLM_EFFORT=low

# ---------- Razorpay (test mode) ----------
# Leave the gateway as "simulator" for offline demos.
REVYN_GATEWAY=simulator
# REVYN_GATEWAY=razorpay
# REVYN_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# REVYN_RAZORPAY_KEY_SECRET=xxxxxxxx
# REVYN_RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# ---------- Orchestrator ----------
REVYN_SCHEDULER_ENABLED=true
REVYN_SCHEDULER_INTERVAL_SECONDS=10
REVYN_CLOCK_SPEEDUP=120

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
